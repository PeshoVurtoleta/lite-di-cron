{
  "name": "@zakkster/lite-di-cron",
  "version": "1.0.0-alpha.1",
  "author": "Zahary Shinikchiev <shinikchiev@yahoo.com>",
  "description": "Wall-clock task scheduler over an @zakkster/lite-di-container topology: DI-constructed jobs registered as boot-locked per-id singletons, fired by index on an interval / every / cron-expr schedule. Zero allocation on the synchronous, non-promise tick path.",
  "type": "module",
  "main": "./Cron.js",
  "module": "./Cron.js",
  "types": "./Cron.d.ts",
  "exports": {
    ".": {
      "types": "./Cron.d.ts",
      "node": "./Cron.js",
      "import": "./Cron.js",
      "default": "./Cron.js"
    }
  },
  "scripts": {
    "test": "node --expose-gc --test test/*.test.js",
    "torture": "node --expose-gc test/torture.mjs",
    "verify": "npm test && npm run torture",
    "prepublishOnly": "npm run verify"
  },
  "files": [
    "Cron.js",
    "Cron.d.ts",
    "LICENSE",
    "llms.txt",
    "CHANGELOG.md",
    "COOKBOOK.md",
    "README.md"
  ],
  "keywords": [
    "cron",
    "scheduler",
    "task scheduler",
    "setInterval",
    "dependency injection",
    "di",
    "wall clock",
    "zero-gc",
    "zero allocation",
    "typescript"
  ],
  "license": "MIT",
  "sideEffects": false,
  "peerDependencies": {
    "@zakkster/lite-di-container": ">=2.0.0"
  },
  "devDependencies": {
    "@zakkster/lite-di-container": "^2.0.0",
    "@zakkster/lite-gc-profiler": "^1.15.0",
    "@zakkster/lite-leak": "^1.8.1"
  },
  "homepage": "https://github.com/PeshoVurtoleta/lite-di-cron#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PeshoVurtoleta/lite-di-cron.git"
  },
  "bugs": {
    "url": "https://github.com/PeshoVurtoleta/lite-di-cron/issues",
    "email": "shinikchiev@yahoo.com"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/PeshoVurtoleta"
  },
  "engines": {
    "node": ">=18"
  }
}
